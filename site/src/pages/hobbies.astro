---
import BaseLayout from '../layouts/BaseLayout.astro';

// Animated art pieces (converted from the original GIFs to animated WebP).
const pieces = [
  { title: 'Lost in the City', tag: 'Contemporary', src: '/media/lostincity.webp' },
  { title: 'Faded', tag: 'Abstract', src: '/media/faded.webp' },
  { title: 'Bumia', tag: 'Modern African', src: '/media/bumia.webp' },
];

const loves = ['Painting', 'Fishing', 'Photography', 'Hiking', 'Cooking'];
---

<BaseLayout
  title="Hobbies — Hana Awad"
  description="Beyond design — Hana Awad's animated art pieces, and the things she loves outside work."
>
  <div class="glow-field" aria-hidden="true"></div>

  <div class="hobbies">
    <header class="head">
      <p class="eyebrow">Hobbies</p>
      <h1 class="title">
        <span class="headline-gradient">I love to paint, fish, take pictures, hike &amp; sometimes cook.</span>
      </h1>
      <div class="loves">
        {loves.map((l) => <span class="chip">{l}</span>)}
      </div>
    </header>

    <section class="gallery">
      {
        pieces.map((p) => (
          <figure class="piece reveal">
            <div class="piece-media">
              <img src={p.src} alt={`${p.title} — ${p.tag}`} loading="lazy" decoding="async" />
            </div>
            <figcaption class="piece-cap">
              <span class="piece-title">{p.title}</span>
              <span class="piece-tag">{p.tag}</span>
            </figcaption>
          </figure>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .glow-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      620px 420px at 80% 0%,
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 70%
    );
  }
  .hobbies {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(16px, 5vw, 40px) 90px;
  }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0 0 16px;
  }
  .title {
    font-size: clamp(30px, 5.5vw, 52px);
    letter-spacing: -0.02em;
    max-width: 20ch;
    margin: 0 0 24px;
  }
  .loves {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .chip {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }

  .gallery {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .piece {
    border: 1px solid var(--hairline);
    border-radius: 6px;
    background: var(--panel);
    overflow: hidden;
  }
  .piece-media {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--panel-2);
  }
  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .piece-cap {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px 18px;
  }
  .piece-title {
    font-family: var(--font-serif);
    font-size: 18px;
  }
  .piece-tag {
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
