---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const studies = (await getCollection('caseStudies'))
  .filter((s) => !s.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);
const flagships = studies.filter((s) => s.data.tier === 'flagship');
const secondary = studies.filter((s) => s.data.tier === 'secondary');
const archive = studies.filter((s) => s.data.tier === 'archive');

const spec = [
  { k: 'Discipline', v: 'UX + Front-end' },
  { k: 'Projects', v: '06 shipped' },
  { k: 'Flagship', v: '04 studies' },
  { k: 'Status', v: 'Open to roles', accent: true },
];
---

<BaseLayout title="Hana Awad · UX Designer">
  <!-- HERO -->
  <header class="hero">
    <p class="kicker"><span class="mark" aria-hidden="true"></span>UX Designer · Front-end · Copenhagen</p>
    <h1 class="headline">I design usable interfaces <span class="ital">and</span> build them.</h1>
    <p class="intro">
      Ex-architect from Alexandria, now in Copenhagen. I take products from research and
      information architecture through to designed, shipped interfaces.
    </p>

    <dl class="titleblock">
      {
        spec.map((s) => (
          <div class="tb-cell">
            <dt class="tb-k">{s.k}</dt>
            <dd class="tb-v" style={s.accent ? 'color:var(--accent)' : undefined}>{s.v}</dd>
          </div>
        ))
      }
    </dl>
  </header>

  <!-- FLAGSHIP GRID -->
  <section class="work">
    <div class="seclabel"><span class="idx">01</span><h2>Selected work</h2></div>
    <div class="grid">
      {
        flagships.map((s, i) => (
          <ProjectCard
            slug={s.id}
            title={s.data.title}
            client={s.data.client}
            role={s.data.role}
            summary={s.data.summary}
            glow={s.data.glow}
            metric={s.data.metric}
            metricLabel={s.data.metricLabel}
            fig={`A·${String(i + 1).padStart(2, '0')}`}
          />
        ))
      }
    </div>

    {
      secondary.length > 0 && (
        <>
          <div class="seclabel"><span class="idx">02</span><h2>Also</h2></div>
          <div class="grid two">
            {secondary.map((s, i) => (
              <ProjectCard
                slug={s.id}
                title={s.data.title}
                client={s.data.client}
                role={s.data.role}
                summary={s.data.summary}
                glow={s.data.glow}
                fig={`B·${String(i + 1).padStart(2, '0')}`}
              />
            ))}
          </div>
        </>
      )
    }

    <!-- ARCHIVE register -->
    <div class="archive reveal">
      <div class="seclabel"><span class="idx">03</span><h2>More work</h2></div>
      <ul class="archive-list">
        {
          archive.map((a, i) => (
            <li>
              <a class="archive-link" href={`/work/${a.id}`}>
                <span class="archive-no">{`C·${String(i + 1).padStart(2, '0')}`}</span>
                <span class="archive-ttl">{a.data.title}</span>
                <span class="archive-meta">{a.data.client}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(48px, 9vw, 104px) clamp(16px, 5vw, 40px) clamp(32px, 5vw, 56px);
  }
  .kicker {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 26px;
  }
  .headline {
    font-size: clamp(40px, 8vw, 84px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.98;
    max-width: 16ch;
    margin: 0 0 28px;
  }
  .intro {
    font-size: clamp(16px, 2.4vw, 19px);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 58ch;
    margin: 0;
  }

  /* Title block (drawing cartouche) */
  .titleblock {
    margin: 46px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--rule);
    background: var(--panel);
    max-width: 760px;
  }
  .tb-cell {
    padding: 13px 16px;
    border-right: 1px solid var(--hairline-strong);
  }
  .tb-cell:last-child {
    border-right: 0;
  }
  .tb-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 6px;
  }
  .tb-v {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
  }

  .work {
    max-width: 1080px;
    margin: 0 auto;
    padding: 10px clamp(16px, 5vw, 40px) 80px;
  }
  .seclabel {
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-top: 1px solid var(--rule);
    padding: 16px 0 20px;
    margin-top: 44px;
  }
  .seclabel:first-child {
    margin-top: 16px;
  }
  .seclabel .idx {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 13px;
  }
  .seclabel h2 {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .grid.two {
    grid-template-columns: repeat(2, 1fr);
  }

  .archive {
    margin-top: 8px;
  }
  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .archive-link {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: baseline;
    gap: 16px;
    padding: 15px 10px 15px 0;
    border-bottom: 1px solid var(--hairline-strong);
    color: var(--text);
    transition: padding-left 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }
  .archive-link:hover {
    color: var(--accent);
    padding-left: 8px;
  }
  .archive-no {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }
  .archive-ttl {
    font-family: var(--font-serif);
    font-size: 19px;
  }
  .archive-meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    white-space: nowrap;
    text-align: right;
  }

  @media (max-width: 720px) {
    .grid,
    .grid.two {
      grid-template-columns: 1fr;
    }
    .titleblock {
      grid-template-columns: repeat(2, 1fr);
    }
    .tb-cell:nth-child(2) {
      border-right: 0;
    }
    .tb-cell:nth-child(1),
    .tb-cell:nth-child(2) {
      border-bottom: 1px solid var(--hairline-strong);
    }
  }
</style>
