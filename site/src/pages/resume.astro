---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { resume as r } from '../data/resume.js';

const PDF = '/hana-awad-resume.pdf';
const dateRange = (e: { date?: string; start?: string; end?: string }) =>
  e.date ?? [e.start, e.end].filter(Boolean).join(' – ');
---

<BaseLayout
  title="Résumé — Hana Awad"
  description="Hana Awad — UX designer & ex-architect. Experience, education, and skills, with a downloadable ATS-friendly PDF."
>
  <div class="resume">
    <header class="head">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1 class="name"><span class="headline-gradient">{r.name}</span></h1>
        <p class="role">{r.title}</p>
        <p class="contact">
          <span>{r.location}</span>
          <span aria-hidden="true">·</span>
          <a class="link-underline" href={`mailto:${r.email}`}><!--email_off-->{r.email}<!--/email_off--></a>
          <span aria-hidden="true">·</span>
          <a class="link-underline" href={`tel:${r.phone.replace(/[^+\d]/g, '')}`}>{r.phone}</a>
          <span aria-hidden="true">·</span>
          <a class="link-underline" href={r.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </p>
      </div>
      <a class="download" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download PDF
      </a>
    </header>

    <p class="summary">{r.summary}</p>

    <!-- EXPERIENCE -->
    <section class="block reveal">
      <h2 class="h2">Experience</h2>
      <div class="items">
        {
          r.experience.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3 class="item-title">
                  {e.role} <span class="at">— {e.org}</span>
                </h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">{e.location}</p>
              <ul class="bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="block reveal">
      <h2 class="h2">Education</h2>
      <div class="items">
        {
          r.education.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3 class="item-title">{e.title}</h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">{e.org} · {e.location}</p>
              {e.note && <p class="note">{e.note}</p>}
            </article>
          ))
        }
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="block reveal">
      <h2 class="h2">Certifications</h2>
      <p class="place">{r.certifications.org} · {r.certifications.date}</p>
      <div class="chips">
        {r.certifications.items.map((c) => <span class="chip">{c}</span>)}
      </div>
    </section>

    <!-- SKILLS -->
    <section class="block reveal">
      <h2 class="h2">Skills</h2>
      <div class="skills">
        {
          Object.entries(r.skills).map(([group, items]) => (
            <div class="skill-group">
              <p class="skill-label">{group}</p>
              <div class="chips">
                {(items as string[]).map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- LANGUAGES -->
    <section class="block reveal">
      <h2 class="h2">Languages</h2>
      <div class="langs">
        {
          r.languages.map((l) => (
            <div class="lang">
              <span class="lang-name">{l.name}</span>
              <span class="lang-level">{l.level}</span>
            </div>
          ))
        }
      </div>
    </section>

    <div class="foot-cta reveal">
      <a class="download solid" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download the ATS-friendly PDF
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .resume {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(16px, 5vw, 40px) 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0 0 14px;
  }
  .name {
    font-size: clamp(38px, 7vw, 60px);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .role {
    font-size: clamp(16px, 2.4vw, 19px);
    color: var(--text-secondary);
    margin: 0 0 12px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }
  .contact a {
    color: var(--text-secondary);
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--text);
    font-size: 14px;
    white-space: nowrap;
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .download :global(.dl-arrow) {
    transform: rotate(90deg);
    color: var(--accent);
  }
  .download:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .download.solid {
    background: var(--accent);
    color: #16130f;
    border-color: transparent;
    font-weight: 500;
  }
  .download.solid :global(.dl-arrow) {
    color: #16130f;
  }

  .summary {
    margin: 30px 0 8px;
    font-size: clamp(16px, 2.3vw, 18px);
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 68ch;
  }

  .block {
    margin: 44px 0;
  }
  .h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--hairline);
  }
  .items {
    display: grid;
    gap: 24px;
  }
  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .item-title {
    font-size: 18px;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .item-title .at {
    color: var(--text-secondary);
  }
  .range {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
    flex: none;
  }
  .place {
    font-size: 14px;
    color: var(--text-muted);
    margin: 4px 0 0;
  }
  .note {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 6px 0 0;
    line-height: 1.6;
  }
  .bullets {
    margin: 12px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .bullets li {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .bullets li::marker {
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .chip {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }
  .skills {
    display: grid;
    gap: 18px;
  }
  .skill-label {
    font-size: 13px;
    color: var(--text);
    margin: 0;
    font-weight: 500;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .lang {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lang-name {
    font-family: var(--font-serif);
    font-size: 17px;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-muted);
  }

  .foot-cta {
    margin-top: 40px;
  }

  @media (max-width: 560px) {
    .item-head {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
