---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { resume as r } from '../data/resume.js';

const PDF = '/hana-awad-resume.pdf';
const dateRange = (e: { date?: string; start?: string; end?: string }) =>
  e.date ?? [e.start, e.end].filter(Boolean).join(' – ');
---

<BaseLayout
  title="Résumé — Hana Awad"
  description="Hana Awad — UX designer & ex-architect. Experience, education, and skills, with a downloadable ATS-friendly PDF."
>
  <div class="resume">
    <header class="head">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1 class="name"><span class="headline-gradient">{r.name}</span></h1>
        <p class="role">{r.title}</p>
        <p class="contact">
          <span class="loc">{r.location}</span>
          <a class="c-link" href={`mailto:${r.email}`}>
            <Icon name="link" size={14} class="c-ico" /><!--email_off-->{r.email}<!--/email_off-->
          </a>
          <a class="c-link" href={`tel:${r.phone.replace(/[^+\d]/g, '')}`}>
            <Icon name="dot" size={14} class="c-ico" />{r.phone}
          </a>
          <a class="c-link" href={r.links.site} target="_blank" rel="noopener noreferrer">
            <Icon name="globe" size={14} class="c-ico" />hanaawad.com
          </a>
          <a class="c-link" href={r.links.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="external" size={14} class="c-ico" />LinkedIn
          </a>
        </p>
      </div>
      <a class="download" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download PDF
      </a>
    </header>

    <p class="summary">{r.summary}</p>

    <!-- STRENGTHS & WORKING STYLE -->
    <section class="block reveal">
      <h2 class="h2">Strengths &amp; working style</h2>
      <ul class="strengths">
        {
          r.strengths.map((s) => (
            <li class="strength">
              <span class="strength-ico" aria-hidden="true">
                <Icon name={s.icon} size={18} />
              </span>
              <p class="strength-text">
                <strong>{s.label}</strong> — {s.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- EXPERIENCE -->
    <section class="block reveal">
      <h2 class="h2">Experience</h2>
      <div class="timeline">
        {
          r.experience.map((e) => (
            <article class="role">
              <span class="role-dot" aria-hidden="true" />
              <div class="role-head">
                <h3 class="role-title">{e.role}</h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">
                <span class="org">{e.org}</span> · {e.location}
              </p>
              <ul class="bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="block reveal">
      <h2 class="h2">Education</h2>
      <div class="items">
        {
          r.education.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3 class="item-title">{e.title}</h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">{e.org} · {e.location}</p>
              {e.note && <p class="note">{e.note}</p>}
            </article>
          ))
        }
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="block reveal">
      <h2 class="h2">Certifications</h2>
      <p class="place">{r.certifications.org} · {r.certifications.date}</p>
      <div class="chips">
        {r.certifications.items.map((c) => <span class="chip">{c}</span>)}
      </div>
    </section>

    <!-- SKILLS -->
    <section class="block reveal">
      <h2 class="h2">Skills</h2>
      <div class="skills">
        {
          Object.entries(r.skills).map(([group, items]) => (
            <div class="skill-group">
              <p class="skill-label">{group}</p>
              <div class="chips">
                {(items as string[]).map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- LANGUAGES -->
    <section class="block reveal">
      <h2 class="h2">Languages</h2>
      <div class="langs">
        {
          r.languages.map((l) => (
            <div class="lang">
              <span class="lang-name">{l.name}</span>
              <span class="lang-level">{l.level}</span>
            </div>
          ))
        }
      </div>
    </section>

    <div class="foot-cta reveal">
      <a class="download solid" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download PDF
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .resume {
    max-width: 660px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(16px, 5vw, 40px) 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0 0 14px;
  }
  .name {
    font-size: clamp(38px, 7vw, 60px);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .role {
    font-size: clamp(16px, 2.4vw, 19px);
    color: var(--text-secondary);
    margin: 0 0 12px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }
  .contact .loc {
    color: var(--text-muted);
  }
  .c-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    transition: color 0.18s var(--ease-out);
  }
  .c-link :global(.c-ico) {
    color: var(--text-muted);
    transition: color 0.18s var(--ease-out);
    flex: none;
  }
  .c-link:hover,
  .c-link:hover :global(.c-ico) {
    color: var(--accent);
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--text);
    font-size: 14px;
    white-space: nowrap;
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .download :global(.dl-arrow) {
    transform: rotate(90deg);
    color: var(--accent);
  }
  .download:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .download.solid {
    background: var(--accent);
    color: #16130f;
    border-color: transparent;
    font-weight: 500;
  }
  .download.solid :global(.dl-arrow) {
    color: #16130f;
  }

  .summary {
    margin: 32px 0 8px;
    font-size: clamp(16px, 2.3vw, 18px);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .block {
    margin: 56px 0;
  }
  .h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 26px;
    padding-bottom: 14px;
    border-bottom: 1px solid #1c1c22;
  }

  /* Strengths & working style */
  .strengths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .strength {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .strength-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--accent);
    flex: none;
    margin-top: 1px;
  }
  .strength-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    align-self: center;
  }
  .strength-text strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Experience timeline */
  .timeline {
    display: grid;
    gap: 2.4rem;
  }
  .role {
    position: relative;
    padding-left: 26px;
  }
  .role::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 18px;
    bottom: -2.4rem;
    width: 1px;
    background: #1c1c22;
  }
  .role:last-child::before {
    display: none;
  }
  .role-dot {
    position: absolute;
    left: 0;
    top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 9px 1px var(--accent);
  }
  .role-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .role-title {
    font-size: 18px;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .org {
    color: var(--text-secondary);
  }

  .items {
    display: grid;
    gap: 24px;
  }
  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .item-title {
    font-size: 18px;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .item-title .at {
    color: var(--text-secondary);
  }
  .range {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
    flex: none;
  }
  .place {
    font-size: 14px;
    color: var(--text-muted);
    margin: 4px 0 0;
  }
  .note {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 6px 0 0;
    line-height: 1.6;
  }
  .bullets {
    margin: 14px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  .bullets li {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--text-secondary);
  }
  .bullets li::marker {
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .chip {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }
  .skills {
    display: grid;
    gap: 24px;
  }
  .skill-label {
    font-size: 13px;
    color: var(--text);
    margin: 0;
    font-weight: 500;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .lang {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lang-name {
    font-family: var(--font-serif);
    font-size: 17px;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-muted);
  }

  .foot-cta {
    margin-top: 40px;
  }

  @media (max-width: 560px) {
    .item-head,
    .role-head {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
