---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { resume as r } from '../data/resume.js';
import { PDF_HREF } from '../lib/pdf.ts';

const PDF = PDF_HREF;
const dateRange = (e: { date?: string; start?: string; end?: string }) =>
  e.date ?? [e.start, e.end].filter(Boolean).join(' – ');
---

<BaseLayout
  title="Résumé — Hana Awad"
  description="Hana Awad — UX designer & ex-architect. Experience, education, and skills, with a downloadable ATS-friendly PDF."
>
  <div class="resume">
    <header class="head">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1 class="name"><span class="headline-gradient">{r.name}</span></h1>
        <p class="role">{r.title}</p>
        <p class="contact">
          <span class="loc">{r.location}</span>
          <a class="c-link" href={`mailto:${r.email}`}>
            <Icon name="link" size={14} class="c-ico" /><!--email_off-->{r.email}<!--/email_off-->
          </a>
          <a class="c-link" href={`tel:${r.phone.replace(/[^+\d]/g, '')}`}>
            <Icon name="dot" size={14} class="c-ico" />{r.phone}
          </a>
          <a class="c-link" href={r.links.site} target="_blank" rel="noopener noreferrer">
            <Icon name="globe" size={14} class="c-ico" />hanaawad.com
          </a>
          <a class="c-link" href={r.links.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="external" size={14} class="c-ico" />LinkedIn
          </a>
        </p>
      </div>
      <a class="download" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download PDF
      </a>
    </header>

    <p class="summary">{r.summary}</p>

    <!-- STRENGTHS & WORKING STYLE -->
    <section class="block reveal">
      <h2 class="h2">Strengths &amp; working style</h2>
      <ul class="strengths">
        {
          r.strengths.map((s) => (
            <li class="strength">
              <span class="strength-ico" aria-hidden="true">
                <Icon name={s.icon} size={18} />
              </span>
              <p class="strength-text">
                <strong>{s.label}</strong> — {s.body}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- EXPERIENCE -->
    <section class="block reveal">
      <h2 class="h2">Experience</h2>
      <div class="timeline">
        {
          r.experience.map((e) => (
            <article class="job">
              <span class="job-dot" aria-hidden="true" />
              <div class="job-head">
                <h3 class="job-title">{e.role}</h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">
                <span class="org">{e.org}</span> · {e.location}
              </p>
              <ul class="bullets">
                {e.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="block reveal">
      <h2 class="h2">Education</h2>
      <div class="items">
        {
          r.education.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3 class="item-title">{e.title}</h3>
                <span class="range">{dateRange(e)}</span>
              </div>
              <p class="place">{e.org} · {e.location}</p>
              {e.note && <p class="note">{e.note}</p>}
            </article>
          ))
        }
      </div>
    </section>

    <!-- CERTIFICATIONS -->
    <section class="block reveal">
      <h2 class="h2">Certifications</h2>
      <p class="place">{r.certifications.org} · {r.certifications.date}</p>
      <div class="chips">
        {r.certifications.items.map((c) => <span class="chip">{c}</span>)}
      </div>
    </section>

    <!-- SKILLS -->
    <section class="block reveal">
      <h2 class="h2">Skills</h2>
      <div class="skills">
        {
          Object.entries(r.skills).map(([group, items]) => (
            <div class="skill-group">
              <p class="skill-label">{group}</p>
              <div class="chips">
                {(items as string[]).map((s) => <span class="chip">{s}</span>)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- LANGUAGES -->
    <section class="block reveal">
      <h2 class="h2">Languages</h2>
      <div class="langs">
        {
          r.languages.map((l) => (
            <div class="lang">
              <span class="lang-name">{l.name}</span>
              <span class="lang-level">{l.level}</span>
            </div>
          ))
        }
      </div>
    </section>

    <div class="foot-cta reveal">
      <a class="download solid" href={PDF} download>
        <Icon name="arrow" size={16} class="dl-arrow" /> Download PDF
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .resume {
    max-width: 660px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) clamp(16px, 5vw, 40px) 90px;
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0 0 14px;
  }
  .name {
    font-size: clamp(38px, 7vw, 60px);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .role {
    font-size: clamp(16px, 2.4vw, 19px);
    color: var(--text-secondary);
    margin: 0 0 12px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }
  .contact .loc {
    color: var(--text-muted);
  }
  .c-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    transition: color 0.18s var(--ease-out);
  }
  .c-link :global(.c-ico) {
    color: var(--text-muted);
    transition: color 0.18s var(--ease-out);
    flex: none;
  }
  .c-link:hover,
  .c-link:hover :global(.c-ico) {
    color: var(--accent);
  }

  .download {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--text);
    font-size: 14px;
    white-space: nowrap;
    transition: border-color 0.2s var(--ease-out), transform 0.2s var(--ease-out);
  }
  .download :global(.dl-arrow) {
    transform: rotate(90deg);
    color: var(--accent);
  }
  .download:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .download.solid {
    background: var(--accent);
    color: #16130f;
    border-color: transparent;
    font-weight: 500;
  }
  .download.solid :global(.dl-arrow) {
    color: #16130f;
  }

  .summary {
    margin: 32px 0 8px;
    font-size: clamp(16px, 2.3vw, 18px);
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .block {
    margin: 56px 0;
  }
  .h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 26px;
    padding-bottom: 14px;
    border-bottom: 1px solid #1c1c22;
  }

  /* Strengths & working style */
  .strengths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .strength {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .strength-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--accent);
    flex: none;
    margin-top: 1px;
  }
  .strength-text {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    align-self: center;
  }
  .strength-text strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Experience timeline */
  .timeline {
    display: grid;
    gap: 2.4rem;
  }
  .job {
    position: relative;
    padding-left: 26px;
  }
  .job::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 18px;
    bottom: -2.4rem;
    width: 1px;
    background: #1c1c22;
  }
  .job:last-child::before {
    display: none;
  }
  .job-dot {
    position: absolute;
    left: 0;
    top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 9px 1px var(--accent);
  }
  .job-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .job-title {
    font-size: 18px;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .org {
    color: var(--text-secondary);
  }

  .items {
    display: grid;
    gap: 24px;
  }
  .item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .item-title {
    font-size: 18px;
    font-family: var(--font-serif);
    font-weight: 500;
  }
  .item-title .at {
    color: var(--text-secondary);
  }
  .range {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
    flex: none;
  }
  .place {
    font-size: 14px;
    color: var(--text-muted);
    margin: 4px 0 0;
  }
  .note {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 6px 0 0;
    line-height: 1.6;
  }
  .bullets {
    margin: 14px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
  }
  .bullets li {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--text-secondary);
  }
  .bullets li::marker {
    color: var(--accent);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  .chip {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }
  .skills {
    display: grid;
    gap: 24px;
  }
  .skill-label {
    font-size: 13px;
    color: var(--text);
    margin: 0;
    font-weight: 500;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .lang {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lang-name {
    font-family: var(--font-serif);
    font-size: 17px;
  }
  .lang-level {
    font-size: 13px;
    color: var(--text-muted);
  }

  .foot-cta {
    margin-top: 40px;
  }

  @media (max-width: 560px) {
    .item-head,
    .job-head {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>

<!--
  Print / PDF theme. Compacts the on-screen résumé to a readable A4 document
  (same dark design, timeline and chips — just sized for paper) and drops the
  site chrome + download buttons. Used both by the browser's Print dialog and by
  the headless-Chromium PDF renderer (scripts/build-resume-pdf.mjs).
-->
<style is:global>
  @media print {
    @page {
      size: A4;
      /* full-bleed: margins must be 0 so the dark background reaches the paper
         edges (Chromium never paints the @page margin strips). Per-page top
         breathing room is added as padding on the entries below, which — unlike
         margins — is preserved when an entry starts at the top of a page. */
      margin: 0;
    }
    html,
    body {
      background: #0e0e10 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    header.nav,
    footer.foot,
    .download,
    .foot-cta {
      display: none !important;
    }
    /* reveal-on-scroll elements must be visible on paper */
    .reveal {
      opacity: 1 !important;
      transform: none !important;
    }

    .resume {
      max-width: 100% !important;
      margin: 0 !important;
      /* side + first/last page insets (full-bleed dark behind) */
      padding: 13mm 18mm 15mm !important;
      font-size: 10pt;
    }

    /* Header */
    .eyebrow {
      font-size: 7.5pt !important;
      margin: 0 0 6px !important;
    }
    .name {
      font-size: 25pt !important;
      margin: 0 0 4px !important;
    }
    .head > div > .role {
      font-size: 11pt !important;
      margin: 0 0 9px !important;
    }
    .contact {
      font-size: 8.4pt !important;
      gap: 5px 14px !important;
    }
    .contact .c-ico {
      width: 11px !important;
      height: 11px !important;
    }

    /* Summary */
    .summary {
      font-size: 9.6pt !important;
      line-height: 1.6 !important;
      margin: 13px 0 0 !important;
    }

    /* Section rhythm + headings — spacing as top padding (survives page tops,
       unlike margins which Chromium truncates at a page break) so a section
       heading landing on a new page still gets breathing room. */
    .block {
      margin: 0 !important;
      padding-top: 22px !important;
    }
    /* the small Certifications section (a block with chips directly inside)
       stays whole rather than splitting a chip row across a page break */
    .block:has(> .chips) {
      break-inside: avoid;
    }
    .h2 {
      font-size: 8.5pt !important;
      margin: 0 0 12px !important;
      padding-bottom: 8px !important;
      break-after: avoid;
    }

    /* Strengths */
    .strengths {
      gap: 10px !important;
    }
    .strength {
      gap: 11px !important;
      break-inside: avoid;
    }
    .strength-ico {
      width: 26px !important;
      height: 26px !important;
    }
    .strength-ico svg {
      width: 15px !important;
      height: 15px !important;
    }
    .strength-text {
      font-size: 9.4pt !important;
      line-height: 1.55 !important;
    }

    /* Experience — spacing lives on each entry as padding-top (preserved when
       an entry starts a new page); the connector line is dropped for print. */
    .timeline {
      gap: 0 !important;
    }
    .job {
      padding-left: 18px !important;
      padding-top: 20px !important;
      break-inside: avoid;
    }
    .job::before {
      display: none !important;
    }
    .job-dot {
      width: 8px !important;
      height: 8px !important;
      top: 26px !important;
      box-shadow: none !important;
    }
    .job-title {
      font-size: 11pt !important;
    }
    .range {
      font-size: 8.2pt !important;
    }
    .place {
      font-size: 8.6pt !important;
      margin-top: 3px !important;
    }
    .note {
      font-size: 8.6pt !important;
      line-height: 1.55 !important;
    }
    .bullets {
      margin-top: 7px !important;
      gap: 4px !important;
      padding-left: 15px !important;
    }
    .bullets li {
      font-size: 9.2pt !important;
      line-height: 1.55 !important;
    }

    /* Education */
    .items {
      gap: 0 !important;
    }
    .item {
      padding-top: 13px !important;
      break-inside: avoid;
    }
    .item-title {
      font-size: 10.5pt !important;
    }
    /* Skills groups also get top padding so a group starting a page has room */
    .skill-group {
      padding-top: 8px;
      break-inside: avoid;
    }

    /* Chips (certifications + skills) */
    .chips {
      gap: 6px !important;
      margin-top: 8px !important;
      break-inside: avoid; /* don't split a chip cluster across pages */
    }
    .chip {
      font-size: 8.2pt !important;
      padding: 3px 10px !important;
    }
    .skills {
      gap: 12px !important;
    }
    .skill-label {
      font-size: 9.2pt !important;
    }

    /* Languages */
    .langs {
      gap: 10px 22px !important;
    }
    .lang-name {
      font-size: 10.5pt !important;
    }
    .lang-level {
      font-size: 8.2pt !important;
    }
  }
</style>
