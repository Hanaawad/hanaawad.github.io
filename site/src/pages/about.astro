---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';

const skills = [
  'UX strategy',
  'Information architecture',
  'User research',
  'Customer interviews',
  'Personas',
  'Customer journeys',
  'Affinity mapping',
  'Wireframing',
  'Prototyping',
  'UI design',
  'Design systems',
  'Figma',
  'Front end (HTML · CSS · Angular)',
];

// What I own as a senior / lead designer — from the Soundboks lead role.
const leading = [
  {
    title: 'Own the UX strategy end to end',
    body: 'Lead the direction from research and information architecture through to shipped interfaces, translating business requirements and user insights into product concepts.',
  },
  {
    title: 'Lead & mentor the team',
    body: 'Manage and mentor other designers, run design critiques and workshops, and set the rituals that keep quality high and the team moving together.',
  },
  {
    title: 'Set the quarterly roadmap',
    body: 'Each quarter, map the work with the team, prioritise it against user needs and business goals, and turn that into a clear, evidenced plan.',
  },
  {
    title: 'Lead research & discovery',
    body: 'Run research projects, synthesise findings with the team, and turn user pain points into clear, evidenced opportunities.',
  },
  {
    title: 'Build the design system',
    body: 'Create and maintain a Figma component library and design frameworks so the team ships faster and the UI stays consistent.',
  },
  {
    title: 'Partner across the org',
    body: 'Work closely with Product Owners, Engineers, and the Brand & Creative teams from conception to launch, in an agile, weekly sprint process.',
  },
  {
    title: 'Design for scalability',
    body: 'Set up information architecture and patterns that scale to new product categories without another ground up redesign.',
  },
  {
    title: 'Bridge design and build',
    body: 'Because I also write front end code, I keep the handoff honest and the shipped product close to the intent.',
  },
];
---

<BaseLayout
  title="About · Hana Awad"
  description="Hana Awad, UX designer with front end experience and an architect's background, based in Copenhagen."
>
  <div class="about">
    <div class="hero">
      <div class="plate">
        <Image src={portrait} alt="Hana Awad" width={300} height={360} />
        <div class="plate-cap">
          <span>Fig. 01</span>
          <span>Hana Awad</span>
        </div>
      </div>
      <div class="hero-text">
        <p class="kicker"><span class="mark" aria-hidden="true"></span>About</p>
        <h1 class="title">From <span class="ital">buildings</span> to interfaces.</h1>
        <div class="prose">
          <p>
            I'm Hana Awad, a passionate interface and UX designer with front end developer
            experience, and an ex architect from Alexandria, Egypt, now living in Copenhagen,
            Denmark.
          </p>
          <p>
            Architecture taught me to think in structure and flow: how people move through a
            space, what they see first, and how everything fits together. I bring that same
            instinct to digital products, starting from research and information architecture,
            and carrying it through to interfaces that are clear, usable, and shipped.
          </p>
        </div>
      </div>
    </div>

    <div class="prose wide">
      <p>
        As a <strong>Senior UX Design Lead</strong>, my work goes beyond screens: I set the UX
        direction for a product, mentor the designers on my team, and shape the quarterly roadmap,
        prioritising the work against user needs and business goals. I lead research and discovery
        and build the design systems and rituals that let a cross functional team move quickly
        without losing consistency. I partner with product and engineering from the first idea
        through to launch, and because I also write front end code, I design with the grain of
        what's buildable, which keeps the handoff honest and the final product close to the intent.
      </p>
    </div>

    <section class="leading">
      <div class="seclabel"><span class="idx">01</span><h2>As a design lead</h2></div>
      <div class="lead-grid">
        {
          leading.map((l, i) => (
            <div class="lead-item">
              <span class="lead-n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="lead-title">{l.title}</h3>
              <p class="lead-body">{l.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="skills">
      <div class="seclabel"><span class="idx">02</span><h2>What I do</h2></div>
      <div class="chips">
        {skills.map((s) => <span class="chip">{s}</span>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(48px, 9vw, 96px) clamp(16px, 5vw, 40px) 80px;
  }

  /* Hero: plate + text */
  .hero {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: clamp(28px, 5vw, 52px);
    align-items: start;
  }
  .plate {
    border: 1px solid var(--rule);
    padding: 9px;
    background: var(--panel);
  }
  .plate :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(1) contrast(1.02);
  }
  .plate-cap {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    padding: 10px 2px 2px;
  }
  .kicker {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 20px;
  }
  .title {
    font-size: clamp(34px, 6vw, 58px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.0;
    margin: 0 0 24px;
  }
  .prose p {
    font-size: clamp(16px, 2.4vw, 18px);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 64ch;
    margin: 0 0 18px;
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .prose.wide {
    margin-top: 44px;
  }
  .prose strong {
    color: var(--text);
    font-weight: 600;
  }

  .seclabel {
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-top: 1px solid var(--rule);
    padding: 16px 0 22px;
  }
  .seclabel .idx {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 13px;
  }
  .seclabel h2 {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text);
  }

  .leading {
    margin-top: 56px;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .lead-item {
    padding: 20px;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--panel);
  }
  .lead-n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }
  .lead-title {
    font-size: 16px;
    margin: 8px 0 8px;
    font-family: var(--font-serif);
  }
  .lead-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .skills {
    margin-top: 56px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
    padding: 7px 13px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }

  @media (max-width: 680px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .plate {
      max-width: 220px;
    }
    .lead-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
