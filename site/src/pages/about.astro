---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  'UX strategy',
  'Information architecture',
  'User research',
  'Customer interviews',
  'Personas',
  'Customer journeys',
  'Affinity mapping',
  'Wireframing',
  'Prototyping',
  'UI design',
  'Design systems',
  'Figma',
  'Front-end (HTML · CSS · Angular)',
];

// What I own as a senior / lead designer — from the Soundboks lead role.
const leading = [
  {
    title: 'Own the UX strategy end-to-end',
    body: 'Lead the direction from research and information architecture through to shipped interfaces — translating business requirements and user insights into product concepts.',
  },
  {
    title: 'Lead research & discovery',
    body: 'Run research projects, synthesise findings with the team, and turn pain points into a prioritised, evidenced roadmap.',
  },
  {
    title: 'Build the design system',
    body: 'Create and maintain a Figma component library and design frameworks so the team ships faster and the UI stays consistent.',
  },
  {
    title: 'Partner across the org',
    body: 'Work closely with Product Owners, Engineers, and the Brand & Creative teams from conception to launch, in an agile, weekly-sprint process.',
  },
  {
    title: 'Design for scalability',
    body: 'Set up information architecture and patterns that scale to new product categories without another ground-up redesign.',
  },
  {
    title: 'Bridge design and build',
    body: 'Because I also write front-end code, I keep the handoff honest and the shipped product close to the intent.',
  },
];
---

<BaseLayout
  title="About — Hana Awad"
  description="Hana Awad — UX designer with front-end experience and an architect's background, based in Copenhagen."
>
  <div class="glow-field" aria-hidden="true"></div>

  <div class="about">
    <p class="eyebrow">About</p>
    <h1 class="title">
      <span class="headline-gradient">From buildings to interfaces.</span>
    </h1>

    <div class="prose">
      <p>
        I'm Hana Awad — a passionate interface and UX designer with front-end developer
        experience, and an ex-architect from Alexandria, Egypt, now living in Copenhagen,
        Denmark.
      </p>
      <p>
        Architecture taught me to think in structure and flow: how people move through a
        space, what they see first, and how everything fits together. I bring that same
        instinct to digital products — starting from research and information architecture,
        and carrying it through to interfaces that are clear, usable, and shipped.
      </p>
      <p>
        As a <strong>Senior UX Design Lead</strong>, my work goes beyond screens: I set the UX
        direction for a product, lead research and discovery, and build the design systems and
        rituals that let a cross-functional team move quickly without losing consistency. I
        partner with product and engineering from the first idea through to launch — and, because
        I also write front-end code, I design with the grain of what's buildable, which keeps the
        handoff honest and the final product close to the intent.
      </p>
    </div>

    <section class="leading">
      <h2 class="section-h">As a design lead</h2>
      <div class="lead-grid">
        {
          leading.map((l) => (
            <div class="lead-item">
              <h3 class="lead-title">{l.title}</h3>
              <p class="lead-body">{l.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="skills">
      <h2 class="section-h">What I do</h2>
      <div class="chips">
        {skills.map((s) => <span class="chip">{s}</span>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .glow-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      620px 420px at 80% 0%,
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 70%
    );
  }
  .about {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(56px, 10vw, 110px) clamp(16px, 5vw, 40px) 80px;
  }
  .eyebrow {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin: 0 0 18px;
  }
  .title {
    font-size: clamp(40px, 8vw, 68px);
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }
  .prose p {
    font-size: clamp(17px, 2.6vw, 20px);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 64ch;
    margin: 0 0 20px;
  }
  .prose p:first-child {
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.5;
  }
  .leading {
    margin-top: 56px;
  }
  .lead-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .lead-item {
    padding: 20px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .lead-title {
    font-size: 16px;
    margin: 0 0 8px;
    font-family: var(--font-serif);
  }
  .lead-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }
  .skills {
    margin-top: 56px;
    padding-top: 8px;
  }
  .section-h {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 18px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
  }
  .chip {
    font-size: 14px;
    color: var(--text-secondary);
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
  }
  @media (max-width: 560px) {
    .lead-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
