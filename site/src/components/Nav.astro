---
import Icon from './Icon.astro';
import { PDF_HREF } from '../lib/pdf.ts';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const links = [
  { href: '/', label: 'Work', on: path === '/' },
  { href: '/about', label: 'About', on: isActive('/about') },
  { href: '/hobbies', label: 'Hobbies', on: isActive('/hobbies') },
  { href: '/resume', label: 'Résumé', on: isActive('/resume') },
];
---

<header class="nav">
  <a href="/" class="brand">Hana Awad</a>

  <!-- Desktop / tablet inline nav -->
  <nav class="links" aria-label="Primary">
    {links.map((l) => <a href={l.href} class:list={['tab', { on: l.on }]}>{l.label}</a>)}
    <a href={PDF_HREF} class="cv" download>
      <Icon name="arrow" size={14} class="dl-arrow" /> Download PDF
    </a>
  </nav>

  <!-- Mobile menu: native <details> disclosure (accessible, no JS, resets on nav) -->
  <details class="menu">
    <summary aria-label="Menu">
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </summary>
    <nav class="menu-panel" aria-label="Primary">
      {links.map((l) => <a href={l.href} class:list={['menu-item', { on: l.on }]}>{l.label}</a>)}
      <a href={PDF_HREF} class="menu-item cv-item" download>
        <Icon name="arrow" size={15} class="dl-arrow" /> Download PDF
      </a>
    </nav>
  </details>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px clamp(16px, 5vw, 40px);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 500;
    white-space: nowrap;
  }

  /* ---- Desktop / tablet inline links ---- */
  .links {
    display: flex;
    align-items: center;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .tab {
    position: relative;
    padding: 4px 0;
    color: var(--text-secondary);
    white-space: nowrap;
    transition: color 0.18s var(--ease-out);
  }
  .tab:hover {
    color: var(--text);
  }
  .tab.on {
    color: var(--text);
  }
  .tab.on::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
  }
  .cv {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 6px;
    padding: 9px 15px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--text);
    white-space: nowrap;
    transition: background 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }
  .cv :global(.dl-arrow) {
    transform: rotate(90deg);
    color: var(--accent);
    transition: color 0.2s var(--ease-out);
  }
  .cv:hover {
    background: var(--rule);
    color: var(--bg);
  }
  .cv:hover :global(.dl-arrow) {
    color: var(--bg);
  }

  /* ---- Mobile menu ---- */
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .bars {
    display: grid;
    gap: 4px;
  }
  .bars span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.2s var(--ease-out), opacity 0.2s var(--ease-out);
  }
  .menu[open] summary {
    border-color: var(--accent);
  }
  .menu[open] .bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .menu[open] .bars span:nth-child(2) {
    opacity: 0;
  }
  .menu[open] .bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    border-radius: var(--radius);
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.7);
  }
  .menu-item {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 15px;
    color: var(--text-secondary);
  }
  .menu-item:hover,
  .menu-item.on {
    color: var(--text);
    background: var(--panel-2);
  }
  .cv-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .cv-item :global(.dl-arrow) {
    transform: rotate(90deg);
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bars span {
      transition: none;
    }
  }
</style>
