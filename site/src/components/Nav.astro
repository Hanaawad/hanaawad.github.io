---
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="nav">
  <a href="/" class="brand">Hana Awad</a>
  <nav class="links" aria-label="Primary">
    <a href="/" class:list={['tab', { on: isActive('/') && path === '/' }]}>Work</a>
    <a href="/about" class:list={['tab', { on: isActive('/about') }]}>About</a>
    <a href="/resume" class:list={['tab', { on: isActive('/resume') }]}>Résumé</a>
    <a href="/resume" class="cv">CV <Icon name="arrow" size={14} /></a>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px clamp(16px, 5vw, 40px);
    border-bottom: 1px solid var(--hairline);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 17px;
    font-weight: 500;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
  }
  .tab {
    padding: 8px 12px;
    border-radius: 8px;
    color: var(--text-secondary);
    transition: color 0.18s var(--ease-out), background 0.18s var(--ease-out);
  }
  .tab:hover {
    color: var(--text);
    background: var(--panel-2);
  }
  .tab.on {
    color: var(--text);
  }
  .cv {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--panel);
    color: var(--text);
    transition: border-color 0.18s var(--ease-out), transform 0.18s var(--ease-out);
  }
  .cv:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  @media (max-width: 460px) {
    .tab {
      padding: 8px 9px;
    }
    .cv {
      padding: 8px 11px;
    }
  }
</style>
