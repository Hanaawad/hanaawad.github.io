---
// Labeled placeholder box. Phase 4 replaces these with Astro <Image>.
export interface Props {
  label?: string;
  ratio?: string; // e.g. "16/9", "4/3", "3/4"
  class?: string;
}
const { label = 'image', ratio = '16/9', class: klass = '' } = Astro.props;
---

<div
  class={`ph ${klass}`}
  style={`aspect-ratio:${ratio};`}
  role="img"
  aria-label={`Placeholder: ${label}`}
>
  <span class="ph-label">{label}</span>
  <span class="ph-note">image · Phase 4</span>
</div>

<style>
  .ph {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: var(--radius);
    border: 1px dashed var(--hairline-strong);
    background:
      radial-gradient(120% 120% at 50% 0%, color-mix(in srgb, var(--glow) 8%, transparent), transparent 60%),
      var(--panel);
    color: var(--text-muted);
  }
  .ph-label {
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .ph-note {
    font-size: 11px;
    color: var(--text-muted);
  }
</style>
