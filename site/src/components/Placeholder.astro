---
// Labeled placeholder box. Phase 4 replaces these with Astro <Image>.
export interface Props {
  label?: string;
  ratio?: string; // e.g. "16/9", "4/3", "3/4"
  class?: string;
}
const { label = 'image', ratio = '16/9', class: klass = '' } = Astro.props;
---

<div
  class={`ph ${klass}`}
  style={`aspect-ratio:${ratio};`}
  role="img"
  aria-label={label}
>
  <span class="ph-dot" aria-hidden="true"></span>
</div>

<style>
  .ph {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background:
      radial-gradient(130% 130% at 50% 0%, color-mix(in srgb, var(--glow) 16%, transparent), transparent 62%),
      var(--panel);
  }
  .ph-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--glow);
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--glow) 60%, transparent);
    opacity: 0.85;
  }
</style>
