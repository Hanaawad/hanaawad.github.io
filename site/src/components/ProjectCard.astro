---
import Img from './Img.astro';
import Icon from './Icon.astro';

export interface Props {
  slug: string;
  title: string;
  client: string;
  role: string;
  summary: string;
  glow: string;
  metric?: string;
  metricLabel?: string;
}
const { slug, title, client, role, summary, glow, metric, metricLabel } = Astro.props;
---

<a class="card reveal" href={`/work/${slug}`} style={`--glow:${glow};`}>
  <div class="card-media" transition:name={`cs-media-${slug}`}>
    <Img slug={slug} key="hero" alt={`${title} — cover`} ratio="16/10" sizes="(max-width: 720px) 92vw, 520px" />
  </div>
  <div class="card-body">
    <p class="card-meta">{client} · {role}</p>
    <h3 class="card-title" transition:name={`cs-title-${slug}`}>
      {title}
      <Icon name="arrow" size={20} class="card-arrow" />
    </h3>
    <p class="card-summary">{summary}</p>
    {
      metric && (
        <p class="card-metric">
          <span class="card-metric-num">{metric}</span>
          <span class="card-metric-lbl">{metricLabel}</span>
        </p>
      )
    }
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-lg);
    background: var(--panel);
    overflow: hidden;
    transition: transform 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    background: radial-gradient(
      420px 240px at 30% 0%,
      color-mix(in srgb, var(--glow) 20%, transparent),
      transparent 60%
    );
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--glow) 45%, var(--hairline-strong));
  }
  .card:hover::before {
    opacity: 1;
  }
  .card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
    background: var(--panel-2);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  .card-body {
    padding: 18px 20px 22px;
    position: relative;
  }
  .card-meta {
    font-size: 12.5px;
    color: var(--text-muted);
    margin: 0 0 8px;
    letter-spacing: 0.02em;
  }
  .card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: clamp(22px, 3.6vw, 28px);
    margin: 0 0 10px;
  }
  .card-title :global(.card-arrow) {
    color: var(--glow);
    flex: none;
    transition: transform 0.25s var(--ease-out);
  }
  .card:hover :global(.card-arrow) {
    transform: translate(3px, -3px);
  }
  .card-summary {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }
  .card-metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 16px 0 0;
  }
  .card-metric-num {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--glow);
  }
  .card-metric-lbl {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
</style>
