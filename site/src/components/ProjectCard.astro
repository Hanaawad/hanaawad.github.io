---
import Img from './Img.astro';
import Icon from './Icon.astro';

export interface Props {
  slug: string;
  title: string;
  client: string;
  role: string;
  summary: string;
  glow: string;
  metric?: string;
  metricLabel?: string;
  fig?: string;
}
const { slug, title, client, role, summary, glow, metric, metricLabel, fig } = Astro.props;
---

<a class="card reveal" href={`/work/${slug}`} style={`--glow:${glow};`}>
  <div class="card-media" transition:name={`cs-media-${slug}`}>
    <Img slug={slug} key="hero" alt={`${title} cover`} ratio="16/10" sizes="(max-width: 720px) 92vw, 520px" />
    {fig && <span class="card-fig">{fig}</span>}
  </div>
  <div class="card-body">
    <p class="card-meta">{client} · {role}</p>
    <h3 class="card-title" transition:name={`cs-title-${slug}`}>
      {title}
      <Icon name="arrow" size={20} class="card-arrow" />
    </h3>
    <p class="card-summary">{summary}</p>
    {
      metric && (
        <p class="card-metric">
          <span class="card-metric-num">{metric}</span>
          <span class="card-metric-lbl">{metricLabel}</span>
        </p>
      )
    }
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius-sm);
    background: var(--panel);
    overflow: hidden;
    transition: border-color 0.2s var(--ease-out);
  }
  .card:hover {
    border-color: var(--rule);
  }
  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline-strong);
    background: var(--panel-2);
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.4s var(--ease-out);
  }
  .card:hover .card-media :global(img) {
    transform: scale(1.02);
  }
  .card-fig {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--text);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--hairline-strong);
    padding: 3px 8px;
  }
  .card-body {
    padding: 18px 20px 22px;
    position: relative;
  }
  .card-meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin: 0 0 10px;
  }
  .card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-serif);
    font-size: clamp(24px, 3.6vw, 30px);
    margin: 0 0 10px;
  }
  .card-title :global(.card-arrow) {
    color: var(--accent);
    flex: none;
    transition: transform 0.25s var(--ease-out);
  }
  .card:hover :global(.card-arrow) {
    transform: translate(3px, -3px);
  }
  .card-summary {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }
  .card-metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 16px 0 0;
  }
  .card-metric-num {
    font-family: var(--font-serif);
    font-size: 22px;
    color: var(--accent);
  }
  .card-metric-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
</style>
