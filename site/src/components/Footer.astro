---
import { getCollection } from 'astro:content';
import { resume } from '../data/resume.js';

const studies = (await getCollection('caseStudies'))
  .filter((s) => !s.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);
const selected = studies.filter((s) => s.data.tier !== 'archive');
const archive = studies.filter((s) => s.data.tier === 'archive');

const explore = [
  { href: '/', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/hobbies', label: 'Hobbies' },
  { href: '/resume', label: 'Résumé' },
  { href: '/hana-awad-resume.pdf', label: 'Download CV', download: true },
];
---

<footer class="foot">
  <div class="foot-inner">
    <!-- Brand + contact -->
    <div class="foot-brand-col">
      <p class="foot-brand">Hana Awad</p>
      <p class="foot-tag">
        UX designer &amp; ex-architect — I design usable interfaces and build them.
      </p>
      <p class="foot-line">
        <span class="status-dot" aria-hidden="true"></span> Copenhagen · open to UX roles
      </p>
      <div class="foot-contact">
        {/* email_off tells Cloudflare's Email Obfuscation to leave the address alone */}
        <a class="foot-mail" href="mailto:hanaawad_92@hotmail.com"><!--email_off-->hanaawad_92@hotmail.com<!--/email_off--></a>
        <div class="foot-social">
          <a class="link-underline" href={resume.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="link-underline" href="https://www.pinterest.com/hanaawad/_created/" target="_blank" rel="noopener noreferrer">Pinterest</a>
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <nav class="foot-links" aria-label="Footer">
      <div class="foot-group">
        <h2 class="foot-h">Selected work</h2>
        <ul>
          {selected.map((s) => <li><a href={`/work/${s.id}`}>{s.data.title}</a></li>)}
        </ul>
      </div>

      <div class="foot-group">
        <h2 class="foot-h">Explore</h2>
        <ul>
          {
            explore.map((l) => (
              <li>
                <a href={l.href} {...(l.download ? { download: true } : {})}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="foot-group">
        <h2 class="foot-h">More work</h2>
        <ul>
          {archive.map((a) => <li><a href={`/work/${a.id}`}>{a.data.title}</a></li>)}
        </ul>
      </div>
    </nav>
  </div>

  <p class="foot-fine">© {new Date().getFullYear()} Hana Awad · Designed &amp; built in Copenhagen</p>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hairline);
    background: var(--bg);
  }
  .foot-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px clamp(16px, 5vw, 40px) 28px;
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 48px;
  }

  /* Brand column */
  .foot-brand {
    font-family: var(--font-serif);
    font-size: 20px;
    margin: 0 0 12px;
  }
  .foot-tag {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 34ch;
    margin: 0 0 16px;
  }
  .foot-line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    font-size: 14px;
    margin: 0 0 18px;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 9px 1px var(--accent);
    flex: none;
  }
  .foot-contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .foot-mail {
    font-size: 15px;
    color: var(--text);
    align-self: flex-start;
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 1px;
    transition: border-color 0.2s var(--ease-out);
  }
  .foot-mail:hover {
    border-color: var(--accent);
  }
  .foot-social {
    display: flex;
    gap: 16px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .foot-social a:hover {
    color: var(--text);
  }

  /* Link columns */
  .foot-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .foot-h {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-weight: 600;
    margin: 0 0 16px;
  }
  .foot-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .foot-group li {
    font-size: 14.5px;
    line-height: 1.4;
  }
  .foot-group a {
    color: var(--text-secondary);
    transition: color 0.18s var(--ease-out);
  }
  .foot-group a:hover {
    color: var(--text);
  }

  .foot-fine {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px clamp(16px, 5vw, 40px) 44px;
    border-top: 1px solid var(--hairline);
    font-size: 12.5px;
    color: var(--text-muted);
  }

  @media (max-width: 820px) {
    .foot-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  @media (max-width: 520px) {
    .foot-links {
      grid-template-columns: 1fr 1fr;
      gap: 28px 24px;
    }
  }
  @media (max-width: 360px) {
    .foot-links {
      grid-template-columns: 1fr;
    }
  }
</style>
