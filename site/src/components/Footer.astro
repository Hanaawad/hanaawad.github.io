---
// Contact + archive links. Archive is a plain text list (no dedicated pages).
const archive = ['Danon', 'Tumble', 'Yacht', 'Bomae', 'O Boutique', 'Architecture Portfolio'];
---

<footer class="foot">
  <div class="foot-inner">
    <div class="foot-col">
      <p class="foot-brand">Hana Awad</p>
      <p class="foot-line">Copenhagen · open to UX roles</p>
      <a class="foot-mail" href="mailto:hana@hanaawad.com">hana@hanaawad.com</a>
      <div class="foot-social">
        <a class="link-underline" href="https://www.linkedin.com/in/hana-awad-96071b150/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="link-underline" href="https://www.pinterest.com/hanaawad/_created/" target="_blank" rel="noopener noreferrer">Pinterest</a>
      </div>
    </div>
    <div class="foot-col">
      <p class="foot-h">More work</p>
      <ul class="foot-archive">
        {archive.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </div>
  <p class="foot-fine">© {new Date().getFullYear()} Hana Awad · Designed &amp; built in Copenhagen</p>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--hairline);
    background: var(--bg);
  }
  .foot-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 48px clamp(16px, 5vw, 40px) 24px;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
  }
  .foot-brand {
    font-family: var(--font-serif);
    font-size: 18px;
    margin: 0 0 8px;
  }
  .foot-line {
    color: var(--text-secondary);
    font-size: 14px;
    margin: 0 0 14px;
  }
  .foot-mail {
    font-size: 15px;
    color: var(--text);
    border-bottom: 1px solid var(--hairline-strong);
    padding-bottom: 1px;
    transition: border-color 0.2s var(--ease-out);
  }
  .foot-mail:hover {
    border-color: var(--accent);
  }
  .foot-social {
    display: flex;
    gap: 16px;
    margin-top: 18px;
    font-size: 14px;
    color: var(--text-secondary);
  }
  .foot-social a:hover {
    color: var(--text);
  }
  .foot-h {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin: 0 0 14px;
  }
  .foot-archive {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 15px;
    color: var(--text-secondary);
  }
  .foot-fine {
    max-width: 1080px;
    margin: 0 auto;
    padding: 20px clamp(16px, 5vw, 40px) 40px;
    border-top: 1px solid var(--hairline);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  @media (max-width: 560px) {
    .foot-inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
