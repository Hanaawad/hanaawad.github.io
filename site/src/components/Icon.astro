---
// Minimal inline-SVG icon set (stroke = currentColor). Unknown names fall back
// to a neutral dot so the build never breaks on a new icon key.
export interface Props {
  name?: string;
  size?: number;
  class?: string;
}
const { name = 'dot', size = 20, class: klass = '' } = Astro.props;

const paths: Record<string, string> = {
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  profiles:
    '<path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h7"/><circle cx="18" cy="14" r="3"/>',
  eq: '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><circle cx="4" cy="12" r="2"/><circle cx="12" cy="10" r="2"/><circle cx="20" cy="14" r="2"/>',
  panel:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9v6"/><path d="M12 9v6"/><path d="M17 9v6"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  external:
    '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6"/><path d="M10 14 21 3"/>',
  apple:
    '<path d="M12 20.94c1.5 0 2.75-1.06 4-2.06 1.5-1.19 2-3.06 2-3.06s-2-1-2-3.5 2-3.5 2-3.5-1.5-2-4-2c-1.5 0-2.5.62-3.5.62S9.5 3.94 8 3.94c-2.5 0-4 2-4 4.5 0 4.5 3.5 11 6 11 1 0 1.5-.62 2-.62"/><path d="M12 4c0-1.5 1-2.5 2-2.5"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  dot: '<circle cx="12" cy="12" r="4"/>',
};

const d = paths[name] ?? paths.dot;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klass}
  aria-hidden="true"
  set:html={d}
></svg>
